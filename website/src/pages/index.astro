---
import Example from "../components/Example.astro";
import Ornament from "../components/Ornament.astro";
import Base from "../layouts/Base.astro";
import assertSafety from "../examples/assert-safety.ncl?raw";
import defaultWhenMissing from "../examples/default-when-missing.ncl?raw";
import editorOrder from "../examples/editor.ncl?raw";
import migrate from "../examples/migrate.ncl?raw";
import ownSelected from "../examples/own-selected.ncl?raw";
import plainFiles from "../examples/plain-files.ncl?raw";

const repository = "https://github.com/frantic1048/blend";

// Exact `blend view --content-only editor` output on macOS.
const editorTarget = `font_size = 14
plugins = [
    "git",
    "lsp",
]
theme = "latte"`;

// The reconciliation scene is a real session against the editor Order above:
// the Target was edited, then synced Target -> Source key by key.
const editedTarget = `font_size = 16
plugins = [
    "git",
    "lsp",
]
theme = "mocha"`;

const viewOutput = `$ blend view editor
editor
  settings.toml -> ~/.config/editor/settings.toml
    ~ font_size
      << Source: 14
      >> Target: 16
    ~ theme
      << Source: "latte"
      >> Target: "mocha"`;

const syncPrompt = `$ blend sync editor
  editor:settings.toml (~/.config/editor/settings.toml)
    ~ font_size
      << Source: 14
      >> Target: 16
      || Base: 14
    [snapshot] font_size: Target changed (suggests Target)
    [s]ource  [t]arget  s[k]ip  [a]ll-source  a[l]l-target  [q]uit: t`;

const rewritten = `from_config = {
  theme = "mocha",
  font_size =
    if metadata.os == "darwin" then 16 else 12,
  plugins = ["git", "lsp"],
},`;

// The same sync against a variant where font_size is computed.
const computed = `from_config = {
  theme = "mocha",
  font_size = base_size + 2,
  plugins = ["git", "lsp"],
},`;

const formats = ["TOML", "JSON & JSONC", "YAML", "Plaintext"];

const menu = [
  {
    name: "Own only what you mean",
    tag: "'Enforce",
    description:
      "Applications rewrite their own settings. Enforce the one field you care about and leave everything else to the app.",
    code: ownSelected,
  },
  {
    name: "Defaults that respect edits",
    tag: "fun { target }",
    description:
      "A resolver sees the current Target value. Fill in a value only when it is missing; keep whatever the user chose.",
    code: defaultWhenMissing,
  },
  {
    name: "Migrations, served gently",
    tag: "|> match",
    description:
      "Move known old values forward automatically, and hand anything unexpected back to you instead of guessing.",
    code: migrate,
  },
  {
    name: "Guard rails",
    tag: "'Assert",
    description:
      "Check a safety property without silently repairing it. A failed assertion stops the Order and tells you why.",
    code: assertSafety,
  },
  {
    name: "Plain files, too",
    tag: "from_file",
    description:
      "Not everything needs structure. Copy files and directories faithfully, with excludes, machine-local overlays, or symlinks.",
    code: plainFiles,
  },
];
---

<Base
  title="Blend — declarative dotfiles, thoughtfully reconciled"
  description="Blend is a dotfile manager for macOS and Linux. Compose configuration in Nickel, compare it with deployed files by meaning, and reconcile changes in either direction."
  path="/"
  image={{
    path: "/og/home.png",
    alt: "The Blend wordmark, with a winged spoon stirring its underline, beside the headline “Declarative dotfiles, thoughtfully reconciled.”",
  }}
>
  <main id="main" class="home">
    <section class="hero">
      <p class="kicker smallcaps">A dotfile manager for macOS &amp; Linux</p>
      <h1>Declarative dotfiles, <em>thoughtfully</em> reconciled.</h1>
      <p class="lede">
        Compose your configuration in <a href="https://nickel-lang.org/">Nickel</a>.
        Blend renders it into the files your applications read, compares them by
        meaning rather than bytes, and helps both sides meet safely.
      </p>
      <div class="actions">
        <a class="button button-primary" href="/guide/">Read the guide</a>
        <a class="button" href={repository}>View on GitHub</a>
      </div>
      <Example lang="sh" code="brew install frantic1048/tap/blend" />
    </section>

    <Ornament />

    <section class="pairing" aria-labelledby="pairing-title">
      <header class="section-head">
        <p class="kicker smallcaps">The house blend</p>
        <h2 id="pairing-title">One Order, one honest file.</h2>
        <p>
          An Order declares which files to produce and where. Ordinary Nickel
          handles the differences between machines.
        </p>
      </header>
      <div class="pairing-grid">
        <Example caption="orders/editor/order.ncl" code={editorOrder} />
        <div class="pairing-arrow smallcaps" aria-hidden="true">blend sync <span>→</span> on macOS</div>
        <Example caption="~/.config/editor/settings.toml" lang="toml" code={editorTarget} />
      </div>
      <div class="formats">
        <p class="smallcaps" id="formats-label">Renders and compares</p>
        <ul aria-labelledby="formats-label">
          {formats.map((format) => <li>{format}</li>)}
          <li><code>key value</code> lines</li>
          <li><code>key=value</code> lines</li>
        </ul>
        <a href="/guide/#formats">Format details →</a>
      </div>
    </section>

    <Ornament />

    <section class="reconcile" aria-labelledby="reconcile-title">
      <header class="section-head">
        <p class="kicker smallcaps">The return pour</p>
        <h2 id="reconcile-title">Then the file talks back.</h2>
        <p>
          Applications rewrite their settings, and so do you. Blend notices,
          explains the change by meaning, and lets you choose which side
          wins, even carrying the edit back into your Nickel.
        </p>
      </header>
      <ol class="scene">
        <li>
          <h3>The app changes a value</h3>
          <p>You pick a darker theme and a larger font in the editor. The Target no longer matches its Source.</p>
          <Example caption="~/.config/editor/settings.toml" lang="toml" code={editedTarget} mark={[1, 6]} />
        </li>
        <li>
          <h3>Blend explains it by meaning</h3>
          <p>
            <code>blend view</code> compares parsed values, not lines, so reformatting or
            reordering keys is not a difference. Changed values are.
          </p>
          <Example lang="blend-output" code={viewOutput} />
        </li>
        <li>
          <h3>You choose a direction</h3>
          <p>
            <code>blend sync</code> asks per key. The last sync’s snapshot shows which side
            moved. Source rewrites the file; Target adopts the edit.
          </p>
          <Example lang="blend-output" code={syncPrompt} wrap />
        </li>
      </ol>
      <div class="outcomes">
        <div class="outcome">
          <h3>Rewritten in your declaration</h3>
          <p>
            A concrete value is edited in place, even inside the active branch of
            a condition: the macOS size becomes 16 and Linux keeps 12.
          </p>
          <Example caption="orders/editor/order.ncl" code={rewritten} mark={[2, 4]} />
        </div>
        <div class="outcome">
          <h3>Handed back to you</h3>
          <p>
            A computed value has no single literal to rewrite. Blend adopts what
            it safely can, says what it could not, and keeps reporting the
            difference until you edit the declaration.
          </p>
          <Example caption="orders/editor/order.ncl" code={computed} mark={[2]} />
          <p class="outcome-message">
            <samp>Cannot apply Target -> Source for font_size: unsupported expression type (update order.ncl manually)</samp>
          </p>
        </div>
      </div>
      <p class="reconcile-more">
        <a href="/guide/#snapshots-and-reverse-sync">What reverse sync can rewrite →</a>
      </p>
    </section>

    <Ornament />

    <section class="menu" aria-labelledby="menu-title">
      <header class="section-head">
        <p class="kicker smallcaps">On the menu</p>
        <h2 id="menu-title">Say who owns each field.</h2>
        <p>
          Choosing a side by hand suits a one-off change. For differences that
          keep coming back, a small vocabulary lets the declaration settle them
          on its own.
        </p>
      </header>
      <ol class="menu-list">
        {
          menu.map((item) => (
            <li class="menu-item">
              <div class="menu-line">
                <h3>{item.name}</h3>
                <span class="menu-leader" aria-hidden="true" />
                <code class="menu-tag">{item.tag}</code>
              </div>
              <p>{item.description}</p>
              <Example code={item.code} />
            </li>
          ))
        }
      </ol>
      <p class="menu-more">
        <a href="/guide/#declaration-and-resolution">The full resolution vocabulary →</a>
      </p>
    </section>

    <Ornament />

    <section class="workflow" aria-labelledby="workflow-title">
      <header class="section-head">
        <p class="kicker smallcaps">How a sync goes</p>
        <h2 id="workflow-title">Look first, then pour.</h2>
      </header>
      <ol class="workflow-steps">
        <li>
          <code>blend</code>
          <p>Summarize which Orders agree with their Targets. Writes nothing.</p>
        </li>
        <li>
          <code>blend view</code>
          <p>Preview generated content and semantic differences. Writes nothing.</p>
        </li>
        <li>
          <code>blend sync</code>
          <p>Reconcile, choosing Source or Target per difference, or let declared policies decide.</p>
        </li>
      </ol>
    </section>

    <Ornament />

    <section class="start" aria-labelledby="start-title">
      <header class="section-head">
        <p class="kicker smallcaps">First cup</p>
        <h2 id="start-title">Start with a file you already have.</h2>
      </header>
      <Example
        lang="sh"
        code={`brew install frantic1048/tap/blend
mkdir dotfiles && cd dotfiles
blend init
blend add git ~/.config/git`}
      />
      <details class="install-more">
        <summary class="smallcaps">Other ways to install</summary>
        <h3>Release installer</h3>
        <p>Verifies the release checksum and installs to <code>~/.local/bin</code> by default.</p>
        <Example
          lang="sh"
          wrap
          code={`release=${repository}/releases/latest/download
curl -fsSLO "$release/blend-installer.sh"
sh blend-installer.sh`}
        />
        <h3>Container</h3>
        <p>The image entrypoint is <code>blend</code>.</p>
        <Example
          lang="sh"
          code={`docker run --rm \\
  -v "$PWD:/workspace" \\
  -w /workspace \\
  ghcr.io/frantic1048/blend:latest check`}
        />
        <h3>From source</h3>
        <p>The binary is written to <code>target/release/blend</code>.</p>
        <Example
          lang="sh"
          code={`git clone ${repository}.git
cd blend
cargo build --release`}
        />
        <p class="fine-print">
          Release archives support Apple silicon macOS, Intel macOS, and ARM64 or x86-64 GNU/Linux.
        </p>
      </details>
      <p class="start-next">
        <a class="button button-primary" href="/guide/">Continue with the guide</a>
      </p>
    </section>
  </main>
</Base>
