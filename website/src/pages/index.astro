---
import "../styles/global.css";

const repository = "https://github.com/frantic1048/blend";
const guide = `${repository}/blob/main/docs/GUIDE.md`;
const design = `${repository}/blob/main/docs/DESIGN.md`;
const releases = `${repository}/releases`;

const orderExample = `let { Order, .. } = import "../order.contract.ncl" in
{
  blend = {
    prefix = ["~/.config/editor/"],
    files = [{
      name = "settings.toml",
      from_config = {
        theme = "latte",
        font_size = 14,
      },
    }],
  },
} | Order`;

const targetExample = `theme = "latte"
font_size = 14`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Blend is a declarative dotfile manager that composes configuration in Nickel and safely reconciles it with application files."
    />
    <meta name="theme-color" content="#f8efe2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Blend — declarative dotfiles, thoughtfully reconciled</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="page-frame">
      <header class="site-header" aria-label="Primary navigation">
        <a class="wordmark" href="#top" aria-label="Blend home">
          <span class="wordmark-mark" aria-hidden="true">B</span>
          <span>blend</span>
        </a>
        <nav>
          <a href="#how-it-works">How it works</a>
          <a href="#get-started">Get started</a>
          <a href={guide}>Guide</a>
          <a class="nav-github" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" id="top">
          <div class="hero-copy">
            <p class="eyebrow">A dotfile manager for composed configurations</p>
            <h1>Make your configuration feel at home.</h1>
            <p class="lede">
              Blend uses Nickel to describe your intent, then thoughtfully
              reconciles it with the files your applications actually use.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#get-started">Begin with Blend</a>
              <a class="button button-secondary" href={repository}>View on GitHub</a>
            </div>
            <ul class="quiet-list" aria-label="Supported platforms and formats">
              <li>macOS & Linux</li>
              <li>TOML, JSON, JSONC & YAML</li>
              <li>Plain files & directories</li>
            </ul>
          </div>

          <div class="hero-illustration" aria-label="A Blend order becoming an application configuration">
            <div class="ornament ornament-one" aria-hidden="true"></div>
            <div class="ornament ornament-two" aria-hidden="true"></div>
            <div class="code-card source-card">
              <div class="card-label"><span>01</span> Order</div>
              <pre><code>{orderExample}</code></pre>
            </div>
            <div class="blend-seal" aria-hidden="true">
              <span>blend</span>
              <small>reconcile</small>
            </div>
            <div class="code-card target-card">
              <div class="card-label"><span>02</span> Target</div>
              <pre><code>{targetExample}</code></pre>
            </div>
          </div>
        </section>

        <section class="intro" aria-labelledby="intro-title">
          <p class="section-kicker">Configuration, without the tug-of-war</p>
          <h2 id="intro-title">Keep the elegance of a declaration without ignoring reality.</h2>
          <p>
            Your source says what should be true. Your applications keep changing
            their own files. Blend compares both views by meaning—not merely by
            bytes—and helps them meet safely in the middle.
          </p>
        </section>

        <section class="flow-section" id="how-it-works" aria-labelledby="flow-title">
          <div class="section-heading">
            <p class="section-kicker">How it works</p>
            <h2 id="flow-title">One calm path from intent to application.</h2>
          </div>

          <ol class="flow">
            <li>
              <span class="flow-number">01</span>
              <h3>Compose</h3>
              <p>Write reusable, typed Nickel expressions with platform and machine logic where it belongs.</p>
            </li>
            <li>
              <span class="flow-number">02</span>
              <h3>Preview</h3>
              <p>See semantic differences between Source and Target before anything changes.</p>
            </li>
            <li>
              <span class="flow-number">03</span>
              <h3>Reconcile</h3>
              <p>Apply declared policies automatically, or choose a direction when either side may be right.</p>
            </li>
          </ol>
        </section>

        <section class="features" aria-labelledby="features-title">
          <div class="feature-intro">
            <p class="section-kicker">Made for lived-in systems</p>
            <h2 id="features-title">Strong opinions, gently applied.</h2>
            <p>
              Blend keeps its safety boundaries visible. Authoritative fields,
              application-owned state, and unresolved changes each have an
              explicit place.
            </p>
            <a class="text-link" href={design}>Read the design notes <span aria-hidden="true">→</span></a>
          </div>

          <div class="feature-grid">
            <article>
              <span class="feature-glyph" aria-hidden="true">◇</span>
              <h3>Semantic comparison</h3>
              <p>Structured formats are compared as values, so formatting noise stays out of the conversation.</p>
            </article>
            <article>
              <span class="feature-glyph" aria-hidden="true">✦</span>
              <h3>Explicit ownership</h3>
              <p>Declare defaults, enforcement, assertions, absence, and unmanaged target fields close to the data.</p>
            </article>
            <article>
              <span class="feature-glyph" aria-hidden="true">↔</span>
              <h3>Both directions</h3>
              <p>Move safe edits between Source and Target, with snapshots providing the shared base.</p>
            </article>
            <article>
              <span class="feature-glyph" aria-hidden="true">⌁</span>
              <h3>Faithful files</h3>
              <p>Mix declarative structured configuration with literal files, directories, overlays, and symlinks.</p>
            </article>
          </div>
        </section>

        <section class="get-started" id="get-started" aria-labelledby="get-started-title">
          <div>
            <p class="section-kicker">A small beginning</p>
            <h2 id="get-started-title">Settle in with three commands.</h2>
            <p>
              Install Blend, create a home for your Source, then let it scaffold
              the generated contract and metadata.
            </p>
            <a class="text-link" href={guide}>Continue with the user guide <span aria-hidden="true">→</span></a>
          </div>
          <div class="terminal" aria-label="Commands to install and initialize Blend">
            <div class="terminal-top">
              <span></span><span></span><span></span>
              <small>terminal</small>
            </div>
            <pre><code><span class="prompt">$</span> brew install frantic1048/tap/blend
<span class="prompt">$</span> mkdir dotfiles && cd dotfiles
<span class="prompt">$</span> blend init</code></pre>
          </div>
        </section>
      </main>

      <footer>
        <div class="footer-mark" aria-hidden="true">B</div>
        <p>Blend your intent with the system you actually use.</p>
        <nav aria-label="Footer navigation">
          <a href={repository}>GitHub</a>
          <a href={guide}>Guide</a>
          <a href={design}>Design</a>
          <a href={releases}>Releases</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
