---
import "../styles/typography.css";
import "../styles/site.css";
import masthead from "../brand/masthead.svg?raw";

interface Props {
  title: string;
  description: string;
  /** Canonical path of the page, with a trailing slash. Omit for pages that should not be indexed. */
  path?: string;
  type?: "website" | "article";
  image: { path: string; alt: string };
}

const { title, description, path, type = "website", image } = Astro.props;
const repository = "https://github.com/frantic1048/blend";
const site = Astro.site ?? new URL("https://blend.pyonpyon.today");
const canonical = path === undefined ? undefined : new URL(path, site).href;
const imageUrl = new URL(image.path, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f8f1e6" />

    <meta property="og:site_name" content="Blend" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/brand/blend-mark-mono.svg" color="#2b1d16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="ard" href="/.well-known/ard.json" />
    <link rel="preload" href="/fonts/eb-garamond-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <a class="masthead-wordmark" href="/" aria-label="Blend home" set:html={masthead} />
      <nav class="masthead-nav smallcaps" aria-label="Primary">
        <a href="/guide/">Guide</a>
        <a href="/changelog/">Changelog</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>

    <slot />

    <footer class="colophon">
      <p class="smallcaps">Blend · declarative dotfiles, thoughtfully reconciled</p>
      <nav class="smallcaps" aria-label="Footer">
        <a href="/guide/">Guide</a>
        <a href="/changelog/">Changelog</a>
        <a href={`${repository}/releases`}>Releases</a>
        <a href={repository}>GitHub</a>
      </nav>
    </footer>
  </body>
</html>
