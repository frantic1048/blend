{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "Blend dependencies",
      "matchManagers": [
        "cargo",
        "rust-toolchain"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "CI dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Website updates must never reach the blend changelog.",
      "matchFileNames": [
        "website/**"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "website"
    },
    {
      "groupName": "Website dependencies",
      "matchFileNames": [
        "website/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ],
  "reviewers": [
    "frantic1048"
  ]
}
